@startuml
!pragma layout smetana
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontSize 14
actor Aluno
actor Administrador
actor "Treinador IA\n(componente futuro)" as IA

rectangle "Training Platform — Sprint 3" {
  usecase "UC01\nCadastrar usuário" as UC01
  usecase "UC02\nListar usuários" as UC02
  usecase "UC03\nCadastrar treino" as UC03
  usecase "UC04\nAtualizar treino" as UC04
  usecase "UC05\nConsultar treino" as UC05
  usecase "UC06\nListar treinos" as UC06
  usecase "UC07\nExcluir treino" as UC07
  usecase "UC08\nContar entidades" as UC08
}
rectangle "Sprint 4 — relatório de acessos" #F8F8F8 {
  usecase "UC09\nGerar relatório\nde acessos" as UC09
}
rectangle "Planejado na visão — não implementado" #EEEEEE {
  usecase "Acompanhar treinos\nno aplicativo mobile" as FutureApp
  usecase "Conversar sobre adaptações\nda rotina com o agente" as FutureIA
}
Administrador --> UC01
Administrador --> UC02
Administrador --> UC08
Administrador --> UC09
Aluno --> UC03
Aluno --> UC04
Aluno --> UC05
Aluno --> UC06
Aluno --> UC07
Aluno ..> FutureApp
Aluno ..> FutureIA
IA ..> FutureIA
note bottom of UC03
  UC03, UC04, UC05, UC07: após implementação
  Sprint 4, operação bem-sucedida gera
  evento para o dono do treino (RF19).
  UC06 e UC09 não geram eventos.
end note
note bottom of UC09
  HTTP previsto: GET /statistics/accesses
  (formato html ou pdf). Ver UC09.
end note
@enduml
