@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontSize 13
hide empty members

title Sprint 3 — classes de projeto

package "Fronteira e composição" {
  class "routers/users, workouts, statistics" as Routes <<boundary>>
  class "main.create_app" as App <<composition>>
  class ApplicationContext <<frozen>> {
    +users: UserService
    +workouts: WorkoutService
  }
  class FacadeSingletonController <<Singleton, Facade>> {
    -{static} _instance
    -{static} _lock: Lock
    +{static} get_instance(): FacadeSingletonController
    +register_user(context, registration): User
    +list_users(context): User[]
    +create_workout(context, registration): Workout
    +get_workout(context, workout_id): Workout
    +list_workouts(context): Workout[]
    +update_workout(context, workout_id, update): Workout
    +delete_workout(context, workout_id): None
    +count_entities(context): int
  }
}

package "Serviços" {
  class UserService <<control>> {
    +add_user(registration: UserRegistration): User
    +list_users(): User[]
    +count_users(): int
  }
  class WorkoutService <<control>> {
    +create_workout(registration: WorkoutRegistration): Workout
    +get_workout(workout_id): Workout
    +list_workouts(): Workout[]
    +update_workout(workout_id, update: WorkoutUpdate): Workout
    +delete_workout(workout_id): None
    +count_workouts(): int
  }
}

package "Contratos e persistência" {
  interface UserRepository <<Protocol>> {
    +add(data: NewUser): User
    +list_users(): User[]
    +get_by_id(user_id): User | None
    +count(): int
  }
  interface WorkoutRepository <<Protocol>> {
    +add(data: WorkoutRegistration): Workout
    +get_by_id(workout_id): Workout | None
    +list_workouts(): Workout[]
    +update(workout_id, data: WorkoutUpdate): Workout | None
    +delete(workout_id): bool
    +count(): int
  }
  class MemoryUserRepository
  class SQLiteUserRepository
  class MemoryWorkoutRepository {
    -_next_id: int
    -_lock: Lock
  }
  class SQLiteWorkoutRepository
  class "storage.sqlite_connection" as Connection <<module>> {
    +sqlite_connection(path)
  }
}

package "Domínio" {
  class User <<frozen>> {
    +id: int
    +username: str
    +email: str
    +role: UserRole
    -password_hash: str
  }
  enum UserRole {
    STUDENT
    ADMIN
  }
  class Workout <<frozen>> {
    +id: int
    +user_id: int
    +name: str
    +description: str
  }
  class UserRegistration <<frozen DTO>>
  class NewUser <<frozen DTO>>
  class WorkoutRegistration <<frozen DTO>>
  class WorkoutUpdate <<frozen DTO>>
  class PersistenceError <<exception>> {
    +public_message: str
  }
}

App ..> ApplicationContext : cria por aplicação
Routes --> FacadeSingletonController
Routes ..> ApplicationContext : obtém de request.app
FacadeSingletonController ..> ApplicationContext : recebe, não guarda
ApplicationContext --> UserService
ApplicationContext --> WorkoutService
FacadeSingletonController ..> UserService : delega
FacadeSingletonController ..> WorkoutService : delega
UserService --> UserRepository
WorkoutService --> WorkoutRepository
WorkoutService --> UserRepository : verifica vínculo
MemoryUserRepository ..|> UserRepository
SQLiteUserRepository ..|> UserRepository
MemoryWorkoutRepository ..|> WorkoutRepository
SQLiteWorkoutRepository ..|> WorkoutRepository
SQLiteUserRepository ..> Connection
SQLiteWorkoutRepository ..> Connection
User "1" -- "0..*" Workout : vínculo por user_id
User --> UserRole
UserService ..> UserRegistration
UserService ..> NewUser : hash antes da persistência
WorkoutService ..> WorkoutRegistration
WorkoutService ..> WorkoutUpdate
SQLiteUserRepository ..> PersistenceError
SQLiteWorkoutRepository ..> PersistenceError
note bottom of Connection
  Uma conexão por operação, FK habilitada,
  transação confirmada ou revertida e fechamento.
  users + workouts no mesmo arquivo.
end note
note bottom of FacadeSingletonController
  Uma instância por processo; construção com trava.
  Sem contexto ou dados de negócio armazenados.
  count_entities = usuários + treinos do contexto.
end note
@enduml
