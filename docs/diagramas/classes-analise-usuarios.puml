@startuml
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontSize 12
hide empty members

title Sprint 4 — classes de projeto (integração em andamento)

package "Fronteira e composição" {
  class "routers/users, workouts, statistics" as Routes <<boundary>>
  class "main.create_app" as App <<composition>> {
    +repository_factory(storage, path)
  }
  class ApplicationContext <<frozen>> {
    +users: UserService
    +workouts: WorkoutService
    +repositories: Repositories
  }
  class FacadeSingletonController <<Singleton, Facade>> {
    -{static} _instance
    -{static} _lock: Lock
    +{static} get_instance(): FacadeSingletonController
    +count_entities(context): int
    ..
    operações de usuários e treinos
  }
}

package "Negócio — serviços" {
  class UserService <<control>>
  class WorkoutService <<control>> {
    ..
    PR Luigi: UoW + eventos
  }
  class "Relatório (planejado)" as ReportSvc <<control>> #TECHNOLOGY {
    Template Method + agregação
    PR Miguel
  }
}

package "Negócio — domínio" {
  class User <<frozen>>
  class Workout <<frozen>>
  class AccessEvent <<frozen>> {
    +user_id: int
    +operation: Operation
    +occurred_at: datetime (UTC)
  }
  enum UserRole
  class PersistenceError <<exception>>
}

package "Negócio — portas" {
  interface UserRepository <<Protocol>>
  interface WorkoutRepository <<Protocol>> {
    +transaction()
  }
  interface AccessEventRepository <<Protocol>> {
    +add(event)
    +list_between(start, end)
  }
  interface UnitOfWork <<Protocol>> {
    +transaction(): TransactionRepositories
  }
  interface "AccessLogPort (planejado)" as LogPort #TECHNOLOGY
  class TransactionRepositories <<frozen>>
}

package "Infraestrutura — persistência" {
  class Repositories <<frozen>> {
    +users
    +workouts
    +accesses
    +unit_of_work
  }
  interface RepositoryFactory <<Protocol>>
  class MemoryRepositoryFactory
  class SQLiteRepositoryFactory
  class MemoryUnitOfWork
  class SQLiteUnitOfWork
  class MemoryUserRepository
  class SQLiteUserRepository
  class MemoryWorkoutRepository
  class SQLiteWorkoutRepository
  class MemoryAccessEventRepository
  class SQLiteAccessEventRepository
  class "LogAdapter (planejado)" as LogAdapter #TECHNOLOGY
  class "storage.sqlite_connection" as Connection <<module>>
}

App ..> RepositoryFactory : seleciona
RepositoryFactory ..> Repositories : create()
App ..> ApplicationContext : monta serviços + repositórios
Routes --> FacadeSingletonController
Routes ..> ApplicationContext : request.app.state.context
FacadeSingletonController ..> ApplicationContext : recebe, não guarda
ApplicationContext --> UserService
ApplicationContext --> WorkoutService
ApplicationContext --> Repositories
FacadeSingletonController ..> UserService
FacadeSingletonController ..> WorkoutService
UserService --> UserRepository
WorkoutService --> WorkoutRepository
WorkoutService ..> UnitOfWork : mutações + evento (Luigi)
ReportSvc ..> AccessEventRepository : Miguel
ReportSvc ..> FacadeSingletonController : rota /statistics/accesses
MemoryRepositoryFactory ..|> RepositoryFactory
SQLiteRepositoryFactory ..|> RepositoryFactory
MemoryUserRepository ..|> UserRepository
SQLiteUserRepository ..|> UserRepository
MemoryWorkoutRepository ..|> WorkoutRepository
SQLiteWorkoutRepository ..|> WorkoutRepository
MemoryAccessEventRepository ..|> AccessEventRepository
SQLiteAccessEventRepository ..|> AccessEventRepository
Repositories --> UserRepository
Repositories --> WorkoutRepository
Repositories --> AccessEventRepository
Repositories --> UnitOfWork
MemoryUnitOfWork ..|> UnitOfWork
SQLiteUnitOfWork ..|> UnitOfWork
SQLiteUserRepository ..> Connection
SQLiteWorkoutRepository ..> Connection
SQLiteAccessEventRepository ..> Connection
LogAdapter ..|> LogPort
WorkoutService ..> LogPort : opcional, Luigi
User "1" -- "0..*" Workout : user_id
AccessEvent ..> User : proprietário (id)
note bottom of RepositoryFactory
  Abstract Factory: família RAM ou SQLite
  coerente + mesma UoW. ADR 0006.
end note
note bottom of ReportSvc
  Classes ainda não no repositório;
  contrato em openspec/changes/relatorio-de-acessos.
end note
@enduml
